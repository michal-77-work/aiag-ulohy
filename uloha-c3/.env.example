# Copy to agent/.env  (cp .env.example agent/.env) and fill in.
# .env is gitignored - never commit real keys.

# OpenAI - the agent's LLM (gpt-5.6-luna by default).
OPENAI_API_KEY=sk-...

# Optional: override the default model.
# OPENAI_MODEL=gpt-5.6-luna

# Tavily - the web search tool. Free tier is enough. https://tavily.com
TAVILY_API_KEY=tvly-...

# Optional: where the vendor DB MCP server listens (default matches server.py).
# VENDOR_DB_MCP_URL=http://localhost:8020/mcp/
